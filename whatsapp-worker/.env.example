# URL WebSocket-воркер-канала на бэке
# Для локальной разработки:    ws://localhost:4000/ws/worker
# Для прода на Render:          wss://<твой-сервис>.onrender.com/ws/worker
BACKEND_WS=wss://sudoku-api.onrender.com/ws/worker

# Любая длинная случайная строка. Та же самая указывается в бэке (ENV: WORKER_SECRET).
# Сгенерить: openssl rand -hex 32
WORKER_SECRET=paste_long_random_string_here
